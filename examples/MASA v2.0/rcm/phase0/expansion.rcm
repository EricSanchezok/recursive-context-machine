name = "MASA Expansion"

model deepseek-v4-flash {
    protocol = "openai"
    endpoint = "https://api.deepseek.com"
    credentials = { env = "DEEPSEEK_API_KEY" }
    limit = { context = "1000000", output = "393216" }
    modalities = { input = ["text"], output = ["text"] }
}

graph {
    accelerator citation_seed_selector {
        purpose = "masa citation seed selector"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../../prompts/phase0/citation_seed_selector.txt" }
        tools = ["read", "edit", "write", "find"]
    }

    accelerator reference_expander {
        purpose = "masa reference expander"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../../prompts/phase0/reference_expander.txt" }
        tools = ["arxiv_download", "arxiv_search", "read", "edit", "write", "find"]
    }

    accelerator semantic_expander {
        purpose = "masa semantic expander"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../../prompts/phase0/semantic_expander.txt" }
        tools = ["arxiv_search", "read", "edit", "write", "find"]
    }

    flux seed_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux expansion_merge {
        channel = context
        mode = last
        arity = 3
    }

    accelerator expansion_merger {
        purpose = "masa expansion merger"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../../prompts/phase0/expansion_merger.txt" }
        tools = ["read", "edit", "write", "find"]
    }

    input.context -> citation_seed_selector.context

    citation_seed_selector.context -> seed_handoff.slot(0)
    seed_handoff.out -> reference_expander.context
    citation_seed_selector.done -> reference_expander.trigger

    seed_handoff.out -> semantic_expander.context
    citation_seed_selector.done -> semantic_expander.trigger

    citation_seed_selector.context -> expansion_merge.slot(0)
    reference_expander.context -> expansion_merge.slot(1)
    semantic_expander.context -> expansion_merge.slot(2)

    expansion_merge.out -> expansion_merger.context

    expansion_merger.done -> output.done
    expansion_merger.context -> output.context
    expansion_merger.purpose -> output.purpose
}
