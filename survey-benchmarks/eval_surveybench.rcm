name = "surveybench-evaluation"

model gpt55 {
    protocol = "openai"
    endpoint = "https://gmncode.com"
    credentials = { env = "CROSS_JUDGE_API_KEY" }
    limit = { context = "1000000", output = "393216" }
}

accelerator {
    purpose = "SurveyBench evaluation on generated survey"
    models = ["gpt55"]
    policy = "captain"
    prompts = { captain = file "./surveybench/prompt.txt" }
    tools = ["fs"]
}
