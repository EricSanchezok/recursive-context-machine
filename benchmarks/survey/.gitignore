# Benchmark data (large, fetched externally)
benchmarks/
!benchmarks/

# Track the setup module code
!benchmarks/setup.py
!benchmarks/__init__.py

# Re-ignore the downloaded data subdirectories
benchmarks/surveybench/
benchmarks/deepscholar/

# Generated survey outputs
benchmarks/survey/generated/**/*
!benchmarks/survey/generated/.gitkeep

# Evaluation results
benchmarks/survey/results/**/*
!benchmarks/survey/results/.gitkeep

# SciReviewGen dataset (large pickle files)
*.pkl
__pycache__/
