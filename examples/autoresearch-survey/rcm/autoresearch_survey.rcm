name = "Autoresearch Survey Pipeline"

use "./anchor.rcm" as Anchor
use "./query_plan.rcm" as QueryPlan
use "./discovery.rcm" as Discovery
use "./expansion.rcm" as Expansion
use "./rank_pool.rcm" as RankPool
use "./card_plan.rcm" as CardPlan
use "./paper_card.rcm" as PaperCard
use "./research_map.rcm" as ResearchMap
use "./judge_panel.rcm" as JudgePanel
use "./image_planner.rcm" as ImagePlanner
use "./survey_outline.rcm" as SurveyOutline
use "./section_expander.rcm" as SectionExpander
use "./survey_assembler.rcm" as SurveyAssembler
use "./survey_writer_zh.rcm" as SurveyWriterZh

graph {
    accelerator anchor = Anchor
    accelerator query_plan = QueryPlan
    accelerator discovery = Discovery
    accelerator expansion = Expansion
    accelerator rank_pool = RankPool
    accelerator card_plan = CardPlan
    // Fan out over the planned papers: each reads one paper's full text and
    // writes a full-text-grounded, anchor-aware card to run_dir/cards/<id>.md.
    map paper_cards {
        accelerator = PaperCard
        scatter = file "00_card_plan.json"
        gather  = digest
    }
    accelerator research_map = ResearchMap
    accelerator judge_panel = JudgePanel
    accelerator image_planner = ImagePlanner
    accelerator survey_outline = SurveyOutline
    // Fan out over the outline's sections: each writes one detailed section to
    // run_dir/sections/<n>_<slug>.md, grounded in the paper cards.
    map section_expand {
        accelerator = SectionExpander
        scatter = file "00_sections.json"
        gather  = digest
    }
    accelerator survey_assembler = SurveyAssembler
    accelerator survey_writer_zh = SurveyWriterZh

    flux anchor_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux query_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux discovery_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux expansion_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux rank_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux cardplan_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux cards_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux map_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux judge_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux image_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux outline_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux sections_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux zh_handoff {
        channel = context
        mode = last
        arity = 1
    }

    input.purpose -> anchor.purpose

    anchor.context -> anchor_handoff.slot(0)
    anchor_handoff.out -> query_plan.context
    anchor.done -> query_plan.trigger

    query_plan.context -> query_handoff.slot(0)
    query_handoff.out -> discovery.context
    query_plan.done -> discovery.trigger

    discovery.context -> discovery_handoff.slot(0)
    discovery_handoff.out -> expansion.context
    discovery.done -> expansion.trigger

    expansion.context -> expansion_handoff.slot(0)
    expansion_handoff.out -> rank_pool.context
    expansion.done -> rank_pool.trigger

    rank_pool.context -> rank_handoff.slot(0)
    rank_handoff.out -> card_plan.context
    rank_pool.done -> card_plan.trigger

    card_plan.context -> cardplan_handoff.slot(0)
    cardplan_handoff.out -> paper_cards.context
    card_plan.done -> paper_cards.trigger

    paper_cards.context -> cards_handoff.slot(0)
    cards_handoff.out -> research_map.context
    paper_cards.done -> research_map.trigger

    research_map.context -> map_handoff.slot(0)
    map_handoff.out -> judge_panel.context
    research_map.done -> judge_panel.trigger

    judge_panel.context -> judge_handoff.slot(0)
    judge_handoff.out -> image_planner.context
    judge_panel.done -> image_planner.trigger

    image_planner.context -> image_handoff.slot(0)
    image_handoff.out -> survey_outline.context
    image_planner.done -> survey_outline.trigger

    survey_outline.context -> outline_handoff.slot(0)
    outline_handoff.out -> section_expand.context
    survey_outline.done -> section_expand.trigger

    section_expand.context -> sections_handoff.slot(0)
    sections_handoff.out -> survey_assembler.context
    section_expand.done -> survey_assembler.trigger

    survey_assembler.context -> zh_handoff.slot(0)
    zh_handoff.out -> survey_writer_zh.context
    survey_assembler.done -> survey_writer_zh.trigger

    survey_assembler.done -> output.done
    survey_assembler.context -> output.context
    survey_assembler.purpose -> output.purpose
}
