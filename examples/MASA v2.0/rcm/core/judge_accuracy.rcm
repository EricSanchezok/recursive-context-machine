name = "MASA Judge - Accuracy (Factual Consistency + Citation Balance + Redundancy)"

model deepseek-v4-flash {
    protocol = "openai"
    endpoint = "https://api.deepseek.com"
    credentials = { env = "DEEPSEEK_API_KEY" }
    limit = { context = "1000000", output = "393216" }
    modalities = { input = ["text"], output = ["text"] }
}

accelerator {
    purpose = "Evaluate accuracy: factual consistency, citation balance, and redundancy"
    models = ["deepseek-v4-flash"]
    policy = "captain"
    prompts = { captain = file "../../prompts/core/judge_accuracy.txt" }
    tools = ["read", "edit", "write", "find"]
}
