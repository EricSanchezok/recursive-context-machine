name = "DeepSurvey-Bench Evaluation (Cross-Judge)"

model gpt55 {
    protocol = "openai"
    endpoint = "https://gmncode.com/v1"
    credentials = { key = "__CROSS_KEY__" }
    limit = { context = "200000", output = "65536" }
    modalities = { input = ["text"], output = ["text"] }
    model = "gpt-5.5"
}

accelerator {
    purpose = "deepsurvey_bench cross evaluation"
    models = ["gpt55"]
    policy = "captain"
    prompts = { captain = file "../../prompts/eval/deepsurvey_bench.txt" }
    tools = ["fs"]
}
