name = "Parallel Repository Review"

model deepseek-v4-flash {
    protocol = "openai"
    endpoint = "https://api.deepseek.com"
    credentials = { env = "DEEPSEEK_API_KEY" }
    limit = { context = "1000000", output = "393216" }
    modalities = { input = ["text"], output = ["text"] }
}

graph {
    accelerator inspect_crates {
        purpose = "只读查看 Cargo workspace 和 crates 目录，整理这个 Rust 项目的模块结构。不要修改任何文件，不要运行会写入文件的命令。"
        model = "deepseek-v4-flash"
        policy = "captain"
        tools = ["shell", "fs", "find"]
    }

    accelerator inspect_examples {
        purpose = "只读查看 examples 目录中的 RCM 文件，整理这些示例展示了哪些 accelerator/graph 用法。不要修改任何文件，不要运行会写入文件的命令。"
        model = "deepseek-v4-flash"
        policy = "captain"
        tools = ["shell", "fs", "find"]
    }

    flux review_context {
        channel = context
        mode = append
        arity = 2
    }

    accelerator summarize {
        purpose = "基于两个并行分支提供的上下文，用中文总结这个仓库的核心结构，以及 examples 目录如何帮助展示 RCM 的能力。不要修改任何文件。"
        model = "deepseek-v4-flash"
        policy = "captain"
        tools = ["shell", "fs", "find"]
    }

    inspect_crates.context -> review_context.slot(0)
    inspect_examples.context -> review_context.slot(1)
    review_context.out -> summarize.context

    summarize.done -> output.done
    summarize.context -> output.context
    summarize.purpose -> output.purpose
}
