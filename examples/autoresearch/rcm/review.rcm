name = "Autoresearch Review Stage"

model deepseek-v4-flash {
    protocol = "openai"
    endpoint = "https://api.deepseek.com"
    credentials = { env = "DEEPSEEK_API_KEY" }
    limit = { context = "1000000", output = "393216" }
    modalities = { input = ["text"], output = ["text"] }
}

graph {
    // ── Load: stage the paper (and report for the auditor only) ──────────────
    accelerator load {
        purpose = "review the paper for integrity and venue-readiness"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/review_load.txt" }
        tools = ["fs"]
    }

    // ── Four independent reviewers (Reviewer Independence Protocol) ──────────
    // Three read ONLY the paper; the auditor cross-checks paper <-> report.
    accelerator reviewer_novelty {
        purpose = "autoresearch review novelty significance"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/review_novelty.txt" }
        tools = ["fs"]
    }

    accelerator reviewer_soundness {
        purpose = "autoresearch review soundness claims"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/review_soundness.txt" }
        tools = ["fs"]
    }

    accelerator reviewer_clarity {
        purpose = "autoresearch review clarity reproducibility"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/review_clarity.txt" }
        tools = ["fs"]
    }

    accelerator auditor {
        purpose = "autoresearch review auditor"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/review_auditor.txt" }
        tools = ["fs"]
    }

    flux review_panel_merge {
        channel = context
        mode = last
        arity = 4
    }

    // ── Synthesise the panel, then gate with routed findings ─────────────────
    accelerator synthesis {
        purpose = "autoresearch review synthesis"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/review_synthesis.txt" }
        tools = ["fs"]
    }

    accelerator gate {
        purpose = "autoresearch review gate"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/review_gate.txt" }
        tools = ["fs"]
    }

    // ── Wiring ───────────────────────────────────────────────────────────────
    input.purpose -> load.purpose

    load.context -> reviewer_novelty.context
    load.context -> reviewer_soundness.context
    load.context -> reviewer_clarity.context
    load.context -> auditor.context
    load.done -> reviewer_novelty.trigger
    load.done -> reviewer_soundness.trigger
    load.done -> reviewer_clarity.trigger
    load.done -> auditor.trigger

    reviewer_novelty.context -> review_panel_merge.slot(0)
    reviewer_soundness.context -> review_panel_merge.slot(1)
    reviewer_clarity.context -> review_panel_merge.slot(2)
    auditor.context -> review_panel_merge.slot(3)
    review_panel_merge.out -> synthesis.context

    synthesis.context -> gate.context
    synthesis.done -> gate.trigger

    gate.done -> output.done
    gate.context -> output.context
    gate.purpose -> output.purpose
}
