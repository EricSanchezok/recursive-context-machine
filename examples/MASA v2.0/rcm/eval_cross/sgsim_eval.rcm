name = "SGSimEval Evaluation (Cross-Judge)"

model gpt55 {
    protocol = "openai"
    endpoint = "https://gmncode.com/v1"
    credentials = { key = "REDACTED" }
    limit = { context = "200000", output = "65536" }
    modalities = { input = ["text"], output = ["text"] }
    model = "gpt-5.5"
}

accelerator {
    purpose = "sgsim_eval cross evaluation"
    models = ["gpt55"]
    policy = "captain"
    prompts = { captain = file "../../prompts/eval/sgsim_eval.txt" }
    tools = ["fs"]
}
