name = "Autoresearch Explore Stage"

use "./shared/paper_card.rcm" as PaperCard

model deepseek-v4-flash {
    protocol = "openai"
    endpoint = "https://api.deepseek.com"
    credentials = { env = "DEEPSEEK_API_KEY" }
    limit = { context = "1000000", output = "393216" }
    modalities = { input = ["text"], output = ["text"] }
}

graph {
    // ── Anchor: freeze the research direction, create project_dir ────────────
    accelerator anchor {
        purpose = "autoresearch explore anchor"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/explore_anchor.txt" }
        tools = ["rdc_read", "fs", "shell"]
    }

    // ── Landscape: four parallel scouts hunting friction ─────────────────────
    accelerator method_scout {
        purpose = "autoresearch explore method scout"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/explore_method_scout.txt" }
        tools = ["arxiv_search", "fs"]
    }

    accelerator survey_scout {
        purpose = "autoresearch explore survey scout"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/explore_survey_scout.txt" }
        tools = ["arxiv_search", "fs"]
    }

    accelerator venue_scout {
        purpose = "autoresearch explore venue scout"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/explore_venue_scout.txt" }
        tools = ["arxiv_search", "fs"]
    }

    accelerator industry_scout {
        purpose = "autoresearch explore industry scout"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/explore_industry_scout.txt" }
        tools = ["arxiv_search", "webfetch", "fs"]
    }

    flux landscape_merge {
        channel = context
        mode = last
        arity = 4
    }

    accelerator landscape {
        purpose = "autoresearch explore landscape merge"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/explore_landscape.txt" }
        tools = ["fs"]
    }

    // ── Read core papers in full (citation-graph + paper-card fan-out) ────────
    accelerator read_core {
        purpose = "autoresearch explore read core"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/explore_read_core.txt" }
        tools = ["arxiv_download", "arxiv_search", "fs"]
        spawns = ["PaperCard"]
    }

    // ── Wonder: sharpen friction into hypotheses ─────────────────────────────
    accelerator wonder {
        purpose = "autoresearch explore wonder"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/explore_wonder.txt" }
        tools = ["fs"]
    }

    // ── Ideate: three parallel creative lenses ───────────────────────────────
    accelerator lens_mechanism {
        purpose = "autoresearch explore lens mechanism"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/explore_lens_mechanism.txt" }
        tools = ["fs"]
    }

    accelerator lens_transfer {
        purpose = "autoresearch explore lens transfer"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/explore_lens_transfer.txt" }
        tools = ["fs"]
    }

    accelerator lens_contrarian {
        purpose = "autoresearch explore lens contrarian"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/explore_lens_contrarian.txt" }
        tools = ["fs"]
    }

    flux lens_merge {
        channel = context
        mode = last
        arity = 3
    }

    accelerator ideas {
        purpose = "autoresearch explore idea merge"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/explore_ideas.txt" }
        tools = ["fs"]
    }

    // ── Novelty, adversarial review, ranked pool, gate ───────────────────────
    accelerator novelty {
        purpose = "autoresearch explore novelty"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/explore_novelty.txt" }
        tools = ["arxiv_search", "fs"]
    }

    accelerator critic {
        purpose = "autoresearch explore critic"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/explore_critic.txt" }
        tools = ["fs"]
    }

    accelerator pool {
        purpose = "autoresearch explore idea pool"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/explore_pool.txt" }
        tools = ["fs"]
    }

    accelerator gate {
        purpose = "autoresearch explore gate"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/explore_gate.txt" }
        tools = ["rdc_write", "fs"]
    }

    // ── Wiring ───────────────────────────────────────────────────────────────
    input.purpose -> anchor.purpose

    anchor.context -> method_scout.context
    anchor.context -> survey_scout.context
    anchor.context -> venue_scout.context
    anchor.context -> industry_scout.context
    anchor.done -> method_scout.trigger
    anchor.done -> survey_scout.trigger
    anchor.done -> venue_scout.trigger
    anchor.done -> industry_scout.trigger

    method_scout.context -> landscape_merge.slot(0)
    survey_scout.context -> landscape_merge.slot(1)
    venue_scout.context -> landscape_merge.slot(2)
    industry_scout.context -> landscape_merge.slot(3)
    landscape_merge.out -> landscape.context

    landscape.context -> read_core.context
    landscape.done -> read_core.trigger

    read_core.context -> wonder.context
    read_core.done -> wonder.trigger

    wonder.context -> lens_mechanism.context
    wonder.context -> lens_transfer.context
    wonder.context -> lens_contrarian.context
    wonder.done -> lens_mechanism.trigger
    wonder.done -> lens_transfer.trigger
    wonder.done -> lens_contrarian.trigger

    lens_mechanism.context -> lens_merge.slot(0)
    lens_transfer.context -> lens_merge.slot(1)
    lens_contrarian.context -> lens_merge.slot(2)
    lens_merge.out -> ideas.context

    ideas.context -> novelty.context
    ideas.done -> novelty.trigger

    novelty.context -> critic.context
    novelty.done -> critic.trigger

    critic.context -> pool.context
    critic.done -> pool.trigger

    pool.context -> gate.context
    pool.done -> gate.trigger

    gate.done -> output.done
    gate.context -> output.context
    gate.purpose -> output.purpose
}
