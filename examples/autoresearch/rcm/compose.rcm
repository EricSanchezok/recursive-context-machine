name = "Autoresearch Compose (Phase 1 then Phase 2)"

use "./compose_report.rcm" as ComposeReport
use "./compose_paper.rcm" as ComposePaper

graph {
    accelerator report_phase = ComposeReport
    accelerator paper_phase = ComposePaper

    input.purpose -> report_phase.purpose

    report_phase.context -> paper_phase.context
    report_phase.done -> paper_phase.trigger

    paper_phase.done -> output.done
    paper_phase.context -> output.context
    paper_phase.purpose -> output.purpose
}
