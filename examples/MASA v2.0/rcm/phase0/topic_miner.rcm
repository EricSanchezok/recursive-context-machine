name = "MASA Topic Miner"

model deepseek-v4-flash {
    protocol = "openai"
    endpoint = "https://api.deepseek.com"
    credentials = { env = "DEEPSEEK_API_KEY" }
    limit = { context = "1000000", output = "393216" }
    modalities = { input = ["text"], output = ["text"] }
}

accelerator {
    purpose = "masa topic miner — cluster paper profiles into research themes"
    models = ["deepseek-v4-flash"]
    policy = "captain"
    prompts = { captain = file "../../prompts/phase0/topic_miner.txt" }
    tools = ["fs"]
}
