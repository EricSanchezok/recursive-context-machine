// captain.example.rcm — 最简单 accelerator 示例
// 运行: accelerate run captain.example.rcm

name = "Captain Demo"

model deepseek-v4-flash {
    protocol = "openai"
    endpoint = "https://api.deepseek.com"
    credentials = { env = "DEEPSEEK_API_KEY" }
    limit = { context = "1000000", output = "393216" }
    modalities = { input = ["text"], output = ["text"] }
}

accelerator captain {
    name = "Captain Agent"
    purpose = "介绍一下你自己，并说说你能做什么"
    model = "deepseek-v4-flash"
    policy = "captain"
    tools = ["shell", "fs", "find", "wait"]
}
