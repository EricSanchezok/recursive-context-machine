name = "Map Smoke Inner"

// The per-item accelerator a `map` runs once per scattered item. Each run sees
// its item as a `user`/`item`-tagged fragment in context (injected by the Map).

model deepseek-v4-flash {
    protocol = "openai"
    endpoint = "https://api.deepseek.com"
    credentials = { env = "DEEPSEEK_API_KEY" }
    limit = { context = "1000000", output = "8192" }
    modalities = { input = ["text"], output = ["text"] }
}

accelerator {
    purpose = "You are given exactly one work item in your context (a fragment tagged 'item'). Reply with a single short line that acknowledges that item by name. Do not call any tools."
    models = ["deepseek-v4-flash"]
    policy = "captain"
    tools = []
}
