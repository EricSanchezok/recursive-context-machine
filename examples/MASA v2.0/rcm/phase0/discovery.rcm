name = "MASA Discovery"

model deepseek-v4-flash {
    protocol = "openai"
    endpoint = "https://api.deepseek.com"
    credentials = { env = "DEEPSEEK_API_KEY" }
    limit = { context = "1000000", output = "393216" }
    modalities = { input = ["text"], output = ["text"] }
}

graph {
    accelerator method_scout {
        purpose = "masa method scout"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../../prompts/phase0/method_scout.txt" }
        tools = ["arxiv_search", "fs"]
    }

    accelerator benchmark_scout {
        purpose = "masa benchmark scout"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../../prompts/phase0/benchmark_scout.txt" }
        tools = ["arxiv_search", "fs"]
    }

    accelerator survey_scout {
        purpose = "masa survey scout"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../../prompts/phase0/survey_scout.txt" }
        tools = ["arxiv_search", "fs"]
    }

    accelerator frontier_scout {
        purpose = "masa frontier scout"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../../prompts/phase0/frontier_scout.txt" }
        tools = ["arxiv_search", "fs"]
    }

    flux scout_merge {
        channel = context
        mode = last
        arity = 4
    }

    accelerator discovery_merger {
        purpose = "masa discovery merger"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../../prompts/phase0/discovery_merger.txt" }
        tools = ["fs"]
    }

    input.context -> method_scout.context
    input.context -> benchmark_scout.context
    input.context -> survey_scout.context
    input.context -> frontier_scout.context

    method_scout.context -> scout_merge.slot(0)
    benchmark_scout.context -> scout_merge.slot(1)
    survey_scout.context -> scout_merge.slot(2)
    frontier_scout.context -> scout_merge.slot(3)

    scout_merge.out -> discovery_merger.context

    discovery_merger.done -> output.done
    discovery_merger.context -> output.context
    discovery_merger.purpose -> output.purpose
}
