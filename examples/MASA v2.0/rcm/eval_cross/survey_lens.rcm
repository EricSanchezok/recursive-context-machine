name = "SurveyLens Evaluation (Cross-Judge)"

model gpt55 {
    protocol = "openai"
    endpoint = "http://127.0.0.1:8001/v1"
    credentials = { env = "CROSS_JUDGE_API_KEY" }
    limit = { context = "200000", output = "65536" }
    modalities = { input = ["text"], output = ["text"] }
}

accelerator {
    purpose = "survey_lens cross evaluation"
    models = ["gpt55"]
    policy = "captain"
    prompts = { captain = file "../../prompts/eval/survey_lens.txt" }
    tools = ["fs"]
}
