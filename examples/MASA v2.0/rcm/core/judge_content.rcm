name = "MASA Judge - Content (Coverage + Citation Relevance + Section Balance)"

model deepseek-v4-flash {
    protocol = "openai"
    endpoint = "https://api.deepseek.com"
    credentials = { env = "DEEPSEEK_API_KEY" }
    limit = { context = "1000000", output = "393216" }
    modalities = { input = ["text"], output = ["text"] }
}

accelerator {
    purpose = "Evaluate content: coverage, citation relevance, and section balance"
    models = ["deepseek-v4-flash"]
    policy = "captain"
    prompts = { captain = file "../../prompts/core/judge_content.txt" }
    tools = ["fs"]
}
