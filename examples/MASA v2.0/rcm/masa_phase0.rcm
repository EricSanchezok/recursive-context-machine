name = "MASA Phase 0 - Paper Discovery"

use "./phase0/anchor.rcm" as Anchor
use "./phase0/query_plan.rcm" as QueryPlan
use "./phase0/discovery.rcm" as Discovery
use "./phase0/expansion.rcm" as Expansion
use "./phase0/paper_fetcher.rcm" as PaperFetcher
use "./phase0/paper_profiler.rcm" as PaperProfiler
use "./phase0/topic_miner.rcm" as TopicMiner
use "./phase0/taxonomy_builder.rcm" as TaxonomyBuilder
use "./phase0/evolution_mapper.rcm" as EvolutionMapper
use "./phase0/coverage_auditor.rcm" as CoverageAuditor

graph {
    accelerator anchor = Anchor
    accelerator query_plan = QueryPlan
    accelerator discovery = Discovery
    accelerator expansion = Expansion
    accelerator paper_fetcher = PaperFetcher
    accelerator paper_profiler = PaperProfiler
    accelerator topic_miner = TopicMiner
    accelerator taxonomy_builder = TaxonomyBuilder
    accelerator evolution_mapper = EvolutionMapper
    accelerator coverage_auditor = CoverageAuditor

    flux anchor_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux query_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux discovery_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux expansion_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux paper_fetcher_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux paper_profiler_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux topic_miner_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux evolution_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux coverage_handoff {
        channel = context
        mode = last
        arity = 1
    }

    anchor.context -> anchor_handoff.slot(0)
    anchor_handoff.out -> query_plan.context
    anchor.done -> query_plan.trigger

    query_plan.context -> query_handoff.slot(0)
    query_handoff.out -> discovery.context
    query_plan.done -> discovery.trigger

    discovery.context -> discovery_handoff.slot(0)
    discovery_handoff.out -> expansion.context
    discovery.done -> expansion.trigger

    expansion.context -> expansion_handoff.slot(0)
    expansion_handoff.out -> paper_fetcher.context
    expansion.done -> paper_fetcher.trigger

    paper_fetcher.context -> paper_fetcher_handoff.slot(0)
    paper_fetcher_handoff.out -> paper_profiler.context
    paper_fetcher.done -> paper_profiler.trigger

    paper_profiler.context -> paper_profiler_handoff.slot(0)
    paper_profiler_handoff.out -> topic_miner.context
    paper_profiler.done -> topic_miner.trigger

    topic_miner.context -> topic_miner_handoff.slot(0)
    topic_miner_handoff.out -> taxonomy_builder.context
    topic_miner.done -> taxonomy_builder.trigger

    taxonomy_builder.context -> evolution_handoff.slot(0)
    evolution_handoff.out -> evolution_mapper.context
    taxonomy_builder.done -> evolution_mapper.trigger

    evolution_mapper.context -> coverage_handoff.slot(0)
    coverage_handoff.out -> coverage_auditor.context
    evolution_mapper.done -> coverage_auditor.trigger

    coverage_auditor.context -> output.context
    coverage_auditor.done -> output.done
}
