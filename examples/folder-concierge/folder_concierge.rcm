name = "Folder Concierge"

model deepseek-v4-flash {
    protocol = "openai"
    endpoint = "https://api.deepseek.com"
    credentials = { env = "DEEPSEEK_API_KEY" }
    limit = { context = "1000000", output = "393216" }
    modalities = { input = ["text"], output = ["text"] }
}

accelerator {
    purpose = "one-shot local folder concierge"
    models = ["deepseek-v4-flash"]
    policy = "captain"
    prompts = { captain = file "./prompts/folder_concierge.txt" }
    tools = ["read", "edit", "write", "find", "shell"]
}
